+    fn destroyed(&self, state: &mut D, _client: ClientId, virtual_keyboard: &ZwpVirtualKeyboardV1) {
+        // The device only exists once a keymap request was accepted.
+        if !self.data.has_keymap.load(Ordering::Relaxed) {
+            return;
+        }
+
+        let device = self.device(virtual_keyboard);
+
+        // A client may destroy the keyboard, or die, with keys still down.
+        // Release them here like how libinput does with an unplugged keyboard.
+        let pressed = std::mem::take(&mut *self.data.pressed_keys.lock().unwrap());
+        let time = InputTime::now().millis();
+        for key in pressed.into_iter().rev() {
+            state.process_virtual_keyboard_event(InputEvent::Keyboard {
+                event: VirtualKeyboardKeyEvent {
+                    device: device.clone(),
+                    time,
+                    key,
+                    state: KeyState::Released,
+                },
+            });
+        }
+
+        // Modifiers set through the `modifiers` request are deliberately not
+        // cleared since the masks are absolute, and a virtual keyboard using
+        // the seat's keymap (either by sending `no_keymap`, or the same one)
+        // shares the seat's xkb state, so an all-zero mask would clear
+        // modifiers set by other devices. A virtual keyboard with its own
+        // keymap doesn't have this problem, since the seat's xkb state is
+        // rebuilt when the compositor switches keymaps back.
+        //
+        // The compositor should reconcile the modifier state itself on
+        // DeviceRemoved (e.g., based on the bits the virtual keyboard actually
+        // changed).
+        state.process_virtual_keyboard_event(InputEvent::DeviceRemoved { device });
+    }
+}
+
+/// Largest keymap accepted from a virtual keyboard. Real keymaps are tens of
+/// kilobytes.
+const MAX_KEYMAP_SIZE: usize = 4 * 1024 * 1024;
+
+/// Compile a client-supplied `xkb_v1` keymap, normalizing it to
+/// `XKB_KEYMAP_FORMAT_TEXT_V1`, and returning it if valid.
+///
+/// The keymap is read rather than memory-mapped: a client can claim a `size`
+/// past the end of its file, or truncate the file afterwards, and touching a
+/// mapped page past the end of the file raises SIGBUS in the compositor.
+fn compile_keymap(fd: OwnedFd, size: usize) -> Option<String> {
+    use std::os::unix::fs::FileExt;
+
+    if size == 0 || size > MAX_KEYMAP_SIZE {
+        warn!("Rejected a virtual keyboard keymap of {size} bytes");
+        return None;
+    }
+    let mut bytes = vec![0; size];
+    if let Err(err) = std::fs::File::from(fd).read_exact_at(&mut bytes, 0) {
+        warn!("Failed to read virtual keyboard keymap: {err}");
+        return None;
+    }
+    // The protocol's size includes the terminating NUL.
+    while bytes.last() == Some(&0) {
+        bytes.pop();
+    }
+    let Ok(text) = String::from_utf8(bytes) else {
+        warn!("Virtual keyboard keymap is not UTF-8 text");
+        return None;
+    };
+    let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+    let Some(keymap) = xkb::Keymap::new_from_string(
+        &context,
+        text,
+        xkb::KEYMAP_FORMAT_TEXT_V1,
+        xkb::KEYMAP_COMPILE_NO_FLAGS,
+    ) else {
+        warn!("Failed to compile virtual keyboard keymap");
+        return None;
+    };
+
+    Some(keymap.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1))
+}
