+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group,
+            } => {
+                if !self.data.has_keymap.load(Ordering::Relaxed) {
+                    virtual_keyboard.post_error(
+                        zwp_virtual_keyboard_v1::Error::NoKeymap,
+                        "`modifiers` sent before keymap.",
