+    fn destroyed(&self, state: &mut D, _client: ClientId, virtual_keyboard: &ZwpVirtualKeyboardV1) {
+        // The device only exists once a keymap request was accepted.
+        if !self.data.has_keymap.load(Ordering::Relaxed) {
+            return;
+        }
