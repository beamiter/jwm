[Desktop Entry]
Name=JWM Debug (X11 / xcb)
Comment=JWM X11 compatibility debug session — prefer Wayland for daily use
Exec=env JWM_BACKEND=xcb JWM_DEBUG_KEYS=1 JWM_DEBUG_DRAG=1 RUST_LOG=debug,smithay=warn,libseat=warn,drm=warn RUST_BACKTRACE=1 XDG_CURRENT_DESKTOP=jwm XDG_SESSION_DESKTOP=jwm DESKTOP_SESSION=jwm /usr/local/bin/jwm-tool daemon
TryExec=/usr/local/bin/jwm-tool
Type=Application
DesktopNames=JWM
Categories=System;
StartupNotify=false
NoDisplay=false
