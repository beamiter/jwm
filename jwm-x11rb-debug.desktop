[Desktop Entry]
Name=JWM Debug (X11 / x11rb)
Comment=JWM X11 compatibility debug session — prefer Wayland for daily use
Exec=env JWM_BACKEND=x11rb JWM_DEBUG_KEYS=1 JWM_DEBUG_DRAG=1 RUST_LOG=debug,smithay=warn,libseat=warn,drm=warn RUST_BACKTRACE=1 /usr/local/bin/jwm-tool daemon
TryExec=/usr/local/bin/jwm-tool
Type=Application
Categories=System;
StartupNotify=false
NoDisplay=false
