[Desktop Entry]
Name=JWM (X11 / x11rb)
Comment=JWM X11 compatibility session (x11rb) — prefer the Wayland session for daily use
Exec=env JWM_BACKEND=x11rb JWM_DEBUG_KEYS=0 JWM_DEBUG_DRAG=0 RUST_LOG=info /usr/local/bin/jwm-tool daemon
TryExec=/usr/local/bin/jwm-tool
Type=Application
Categories=System;
StartupNotify=false
NoDisplay=false
