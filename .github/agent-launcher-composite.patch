+
+/// Turn launcher text into an argv only when it clearly names a runnable
+/// program. No shell is involved: pipes, redirections and expansions remain
+/// ordinary arguments instead of being interpreted by `/bin/sh`.
+///
+/// A normal query needs at least one argument after the executable, which
+/// preserves regular multi-word application search. Prefixing with `>` makes
+/// command mode explicit and also permits a single executable.
+fn direct_command(query: &str, entries: &[LaunchEntry]) -> Option<Vec<String>> {
+    let trimmed = query.trim();
+    let (explicit, text) = match trimmed.strip_prefix('>') {
+        Some(rest) => (true, rest.trim_start()),
+        None => (false, trimmed),
+    };
+    let command = parse_exec(text);
+    if command.is_empty() || (!explicit && command.len() < 2) {
+        return None;
+    }
+
+    let program = &command[0];
+    let known = entries.iter().any(|entry| {
+        entry.command.first().is_some_and(|candidate| {
+            candidate == program
+                || Path::new(candidate).file_name().and_then(|name| name.to_str())
+                    == Some(program.as_str())
+        })
+    });
+    if !known && !is_executable_path(program) {
+        return None;
+    }
+    Some(command)
+}
+
+fn is_executable_path(program: &str) -> bool {
+    // Bare names are accepted only when application discovery found them on
+    // PATH. Here we handle explicit relative/absolute executable paths.
+    if !program.contains('/') {
+        return false;
+    }
+    let Ok(metadata) = fs::metadata(program) else {
+        return false;
+    };
+    if !metadata.is_file() {
+        return false;
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        metadata.permissions().mode() & 0o111 != 0
+    }
+    #[cfg(not(unix))]
+    {
+        true
+    }
+}
 
